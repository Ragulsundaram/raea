--- /dev/null
+++ b/src/nodes.ts
@@ -0,0 +1,64 @@
+// The tree as React last committed it, kept on the instances themselves (raea's patch, docs/layout-reads.feature
+// LR4): each element and text instance knows its parent, its children in order, and its latest props or text. A host
+// can then answer DOM-shaped reads (children, querySelector, textContent) from the instances a ref already holds,
+// without parsing the op stream. Containers get an element of their own, so a top-level instance has a parent.
+
+/** A node of the committed tree: an element or a text run. */
+export class BevyNode {
+  parentNode: BevyElement | null = null;
+  constructor(
+    /** The node's reconciler id (what its ops name). */
+    readonly id: number,
+  ) {}
+}
+
+/** A host element: what a ref holds (a `<canvas>`'s is BevyCanvasElement, one of these too). */
+export class BevyElement extends BevyNode {
+  childNodes: BevyNode[] = [];
+  constructor(
+    id: number,
+    /** The JSX type ("div", "span", "text" ...). */
+    readonly type: string,
+    /** The wire kind it was created as (`type`, except inside a `<text>`). */
+    readonly kind: string | undefined,
+    /** Its props as React last committed them. */
+    public props: Record<string, unknown>,
+  ) {
+    super(id);
+  }
+}
+
+/** A text run: a bare string child. */
+export class BevyTextNode extends BevyNode {
+  constructor(
+    id: number,
+    public data: string,
+  ) {
+    super(id);
+  }
+}
+
+const containers = new Map<number, BevyElement>();
+
+/** The element standing for container `id` (the root a tree is mounted in). */
+export function containerNode(id: number): BevyElement {
+  let c = containers.get(id);
+  if (!c) containers.set(id, (c = new BevyElement(id, "root", "root", {})));
+  return c;
+}
+
+/** `child` put under `parent`, before `before` (at the end without it), taken from wherever it was. */
+export function link(parent: BevyElement, child: BevyNode, before?: BevyNode): void {
+  if (child.parentNode) unlink(child.parentNode, child);
+  const at = before ? parent.childNodes.indexOf(before) : -1;
+  if (at < 0) parent.childNodes.push(child);
+  else parent.childNodes.splice(at, 0, child);
+  child.parentNode = parent;
+}
+
+/** `child` taken out of `parent`. */
+export function unlink(parent: BevyElement, child: BevyNode): void {
+  const at = parent.childNodes.indexOf(child);
+  if (at >= 0) parent.childNodes.splice(at, 1);
+  if (child.parentNode === parent) child.parentNode = null;
+}
